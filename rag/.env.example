# Consultation des textes sans appel OpenAI (configuration de départ).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
CONSULTATION_MODE=true
RETRIEVAL_MODE=lexical
# retrieval : 8 passages retrouvés ; full : tout le résumé dans le prompt (mis en cache)
CONTEXT_MODE=retrieval
# Recherche : paraphrases d'index (recréer l'index après changement), synonymes, décomposition
# des questions (1 appel de plus par question, gain non démontré), plafond par sous-section (nuit au rappel)
INDEX_ENRICHMENT=true
SYNONYMS=true
QUERY_PLANNING=false
RETRIEVAL_COUNT=12
# Recherche complémentaire avant d'affirmer qu'une information est absente (jusqu'à 1 appel de plus)
VERIFY_ABSENCE=false
RETRIEVAL_PER_SUBSECTION=0
CHATI_HOST=127.0.0.1
CHATI_PORT=8080
OPENAI_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=4
WEB_SEARCH_ENABLED=true
WEB_MAX_TOOL_CALLS=3
# Objection ou question de financement : recherche web d'exemples à l'étranger et de la base
# juridique (1 appel web de plus par objection ; OpenAI seulement)
OBJECTION_RESEARCH=true
# Cache en mémoire des réponses vérifiées aux questions autonomes (0 = désactivé),
# amorcé au démarrage depuis ce fichier (scripts/warm_cache.py)
ANSWER_CACHE_SIZE=300
ANSWER_CACHE_FILE=data/programme/answers.jsonl
# Profil « Je suis… » : bonus de classement des mesures qui concernent le profil déclaré
PROFILE_BOOST=0.005
# Diffusion provisoire des blocs dès qu'ils sont écrits (la réponse validée les remplace)
STREAM_BLOCKS=false

# Pour le RAG hybride avec Luna : renseigner la clé, passer CONSULTATION_MODE
# à false et RETRIEVAL_MODE à hybrid, puis créer l’index (voir README).

# Bêta fermée (Groq + GPT-OSS, quotas par lien dans Firestore) : voir .env.beta.example et docs/BETA.md
